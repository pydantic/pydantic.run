{
  "name": "pydantic-run",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "src/*"
  ],
  "scripts": {
    "format": "prettier --write -- .",
    "lint": "eslint --max-warnings=0 src/*/src && prettier --check -- .",
    "typecheck": "npm run --workspaces typecheck",
    "build": "npm run --workspace=frontend build",
    "dev": "npm run --workspace=frontend dev",
    "cf-typegen": "npm run --workspace=backend cf-typegen",
    "dev-backend": "npm run --workspace=backend dev"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false,
    "trailingComma": "all",
    "tabWidth": 2,
    "printWidth": 119,
    "bracketSpacing": true,
    "plugins": [
      "prettier-plugin-toml"
    ],
    "overrides": [
      {
        "files": "*.toml",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-toml": "^4.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.152.0"
  }
}
